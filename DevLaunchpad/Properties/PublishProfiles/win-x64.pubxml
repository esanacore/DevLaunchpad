<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile consumed by the single-project MSIX packaging targets
  (referenced from the .csproj as win-$(Platform).pubxml). It only needs to map
  the build Platform to a .NET runtime identifier; single-file/trim settings live
  in the .csproj so they stay consistent across platforms.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
</Project>
