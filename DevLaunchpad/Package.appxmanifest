<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="DevLaunchpad"
    Publisher="CN=Eric Sanacore"
    Version="1.2.0.0" />
  <!-- Identity is a placeholder for local/sideload builds. Before submitting to
       the Microsoft Store, use Visual Studio's "Publish > Associate App with the
       Store" (or Partner Center values) to overwrite Name, Publisher, and
       PublisherDisplayName with the identity reserved for this app. See docs/STORE.md. -->

  <Properties>
    <DisplayName>Dev Launchpad</DisplayName>
    <PublisherDisplayName>Eric Sanacore</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Dev Launchpad"
        Description="Launch repositories, dev tools, and local servers from the PowerToys Command Palette."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="DevLaunchpad.exe" Arguments="-RegisterProcessAsComServer" DisplayName="Dev Launchpad">
              <com:Class Id="3ccae5b0-6a8e-4a44-98f7-d5a7b7bcbb43" DisplayName="Dev Launchpad" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.commandpalette"
            Id="ID"
            PublicFolder="Public"
            DisplayName="Dev Launchpad"
            Description="Dev Launchpad">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation>
                  <CreateInstance ClassId="3ccae5b0-6a8e-4a44-98f7-d5a7b7bcbb43" />
                </Activation>
                <SupportedInterfaces>
                  <Commands/>
                </SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust is required for the out-of-process COM server that backs the
         Command Palette extension. No network capability is declared because the
         extension makes no network calls of its own (it shells out to the user's
         browser/editor/terminal). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
